#!/bin/sh
# .githooks/pre-push — runs tools/preflight.mjs and BLOCKS the push if it fails.
#
# Installed with:  git config core.hooksPath .githooks
# (Kept in the repo rather than .git/hooks so it survives a fresh clone and is reviewable.)
#
# WHY THIS IS A HOOK AND NOT A CHECKLIST ITEM
# On 2026-07-20 every test suite was green and pushing would still have disabled every buy
# button on the site: the client had been changed to read availability from a database column
# that does not exist in the live project. Mocked tests cannot catch that — the mock always
# has the column. Only asking the real database does.
#
# A checklist you can forget is not a control. This runs whether or not anyone remembers it.
#
# To bypass in a genuine emergency:  git push --no-verify
# If you type that, you are asserting you have personally verified the live schema. Alex's
# rule: "if you make an update for the website and dont push you fucked up" — the answer to
# that is to FIX the blocker and push, not to skip the check and push something broken.

echo ""
echo "── pre-push: verifying this deploy is safe ─────────────────────────────"

if ! command -v node >/dev/null 2>&1; then
  echo "  node not found — cannot run preflight."
  echo "  Refusing to push blind. Install node or use --no-verify if you have verified manually."
  exit 1
fi

# ── REFRESH THE BUILD STAMP BEFORE THE PUSH ────────────────────────────────
# docs/build-info.json carries the commit the live site was built from, and
# tools/deploy-verify.mjs compares it against local HEAD to answer "did my push actually
# reach the site?".
#
# Cloudflare Pages serves docs/ as STATIC FILES — there is no package.json and no build
# command, so build.mjs never runs there and CF_PAGES_COMMIT_SHA is never available. The
# stamp is therefore only ever as fresh as the last local `node build.mjs`.
#
# Which means: push without running build.mjs and the stamp goes stale, and deploy-verify
# reports STALE on a deploy that landed perfectly. A FALSE ALARM IS HOW A REAL ALARM GETS
# IGNORED — and an ignored deploy check is worse than no deploy check, because it restores
# the exact blind spot it was built to remove.
#
# So the refresh happens here, where it cannot be forgotten, rather than in a runbook step.
# A HOOK MUST NEVER REWRITE HISTORY. The first version of this block ran `git commit --amend`
# to fold the refreshed stamp into the commit being pushed. That was wrong twice over:
#   1. git had ALREADY resolved which ref to push before the hook ran, so the amend changed
#      local HEAD while the OLD hash went to the remote — instantly diverging the repo
#      (observed: local 06fd9c5, remote 8d76b0c, ahead 1 / behind 1).
#   2. The stamp records HEAD at build time, and the amend then CHANGES that hash — so the
#      stamp could never match its own commit no matter what. Chicken and egg.
# It only refreshes and REPORTS now. deploy-verify compares the live stamp against the LOCAL
# STAMP FILE rather than against a commit hash, so the file matching is what matters, not the SHA.
REPO="$(git rev-parse --show-toplevel)"
if [ -f "$REPO/build.mjs" ]; then
  node "$REPO/build.mjs" >/dev/null 2>&1
  if ! git diff --quiet -- "$REPO/docs/build-info.json" 2>/dev/null; then
    echo ""
    echo "  ! BUILD STAMP IS STALE and is NOT in this push."
    echo "    deploy-verify compares the live stamp to your local one, so it will report"
    echo "    STALE until this is committed. Commit it and push again:"
    echo "        git add docs/build-info.json && git commit -m 'refresh build stamp'"
    echo ""
  fi
fi

node "$REPO/tools/preflight.mjs"
STATUS=$?

if [ $STATUS -ne 0 ]; then
  echo ""
  echo "PUSH BLOCKED. Fix the blockers above, or push with --no-verify if you have"
  echo "personally verified the live schema is ready."
  echo ""
  echo "Remember the other half (DEPLOY-RUNBOOK.md): if you turned the maintenance"
  echo "splash ON, it must go OFF in this same session. A splash left up is a closed shop."
  echo ""
  exit 1
fi

echo ""
echo "Preflight passed. Pushing."
echo "AFTER the deploy goes live:"
echo "  1. Cloudflare Pages -> confirm the build SUCCEEDED (a red build means the live"
echo "     site is still the OLD code — a push is not a deploy)."
echo "  2. If maintenance mode is on, turn it OFF now:"
echo "       UPDATE public.site_status SET mode='open' WHERE id=1;"
echo "  3. Load the site LOGGED OUT: no splash, buy buttons enabled, one reaches Stripe."
echo ""
exit 0
